# =============================================================================
# BRONTOLANO BUSINESS SUITE - ENVIRONMENT VARIABLES
# =============================================================================
# Database Configuration
POSTGRES_DB=brontolano
POSTGRES_USER=brontolano
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_USER=brontolano
RABBITMQ_PASSWORD=change_this_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# JWT Configuration
JWT_SECRET=change_this_jwt_secret_key
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=86400

# MinIO Object Storage
MINIO_ROOT_USER=brontolano
MINIO_ROOT_PASSWORD=change_this_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Application Version
AUTH_VERSION=1.0.0
CRM_VERSION=1.0.0
SALES_VERSION=1.0.0
INVENTORY_VERSION=1.0.0
FINANCE_VERSION=1.0.0
HR_VERSION=1.0.0
NOTIFICATIONS_VERSION=1.0.0
WEB_VERSION=1.0.0
MOBILE_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Server Configuration
DOMAIN=localhost
API_PORT=3001
WEB_PORT=3000

# SSL Certificates (for production)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
